# Optional overrides for npm run dev and npm run dev:server.
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3000
BROWSER_SYNC_SOCKET_PORT=3002
DEFAULT_ACCOUNT_LEVEL=free
SKIP_OPEN5E_API=1

# Adds a "Shut Down Server" button in Settings > About that gracefully stops
# the process. Only for a local, single-user instance - never enable this on
# a shared/public deployment. The route itself requires a per-process token
# that's only ever sent to the DM-facing tracker page (not Player View), but
# this still isn't meant for a deployment other visitors are trusted on.
ALLOW_SERVER_SHUTDOWN=true
